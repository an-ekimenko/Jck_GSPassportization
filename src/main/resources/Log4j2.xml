<?xml version="1.0" encoding="UTF-8"?>
<!-- TRACE | DEBUG | INFO | WARN | ERROR | FATAL  - and also ALL|OFF enabling/disabling all levels respectively -->
<Configuration status="WARN">

  <Properties>
    <!-- If the logs variable is not passed from the outside, 
         the logs are written to the logs folder located next to the launch location.
    -->
    <Property name="logDir">${sys:log.dir:-${sys:user.dir}/logs}</Property>
  </Properties>


  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
      <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
    </Console>
    
    <File name="commons-log" fileName="${logDir}/commons.log" append="false">
       <PatternLayout pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss} [%t] %c - %msg%n"/>
    </File>
    
    <File name="p6spy" fileName="${logDir}/p6spy.log" append="false">
       <PatternLayout pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss} [%t] %c - %msg%n"/>
    </File>
    
  </Appenders>
  <Loggers>
  <Logger name="org.hibernate" level="warn" additivity="false">
      <AppenderRef ref="commons-log" />
  </Logger>
  <Logger name="p6spy" level="info" additivity="false">
      <AppenderRef ref="p6spy" />
  </Logger>
  
  <Root level="info">
      <AppenderRef ref="commons-log"/>
  </Root>
  </Loggers>
</Configuration>
